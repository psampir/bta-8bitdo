{
	"schemaVersion": 1,
	"id": "eightbitdo",
	"version": "${version}",
	"name": "8BitDo Controller Support",
	"description": "Registers runtime GLFW gamepad mappings for every 8BitDo controller, so Better than Adventure's native controller support actually sees it.",
	"authors": [
		"psampir"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/bta-8bitdo",
		"sources": "https://github.com/psampir/bta-8bitdo",
		"issues": "https://github.com/psampir/bta-8bitdo/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "client",
	"mixins": [
		"eightbitdo.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"minecraft": "*",
		"java": ">=${java}"
	}
}
